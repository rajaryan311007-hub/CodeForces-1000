#include <bits/stdc++.h>
using namespace std;
 
int main() {
    long long x;
    cin >> x;
    
    int ans = 0;
    while (x > 0) {
        if (x % 2 == 1) {
            ans++; // Add 1 if the current lowest bit is set
        }
        x /= 2; // Shift right to check the next bit
    }
    
    cout << ans << endl;
    return 0;
}
