#include <bits/stdc++.h>
using namespace std;
int main(){
    long long n,m;
    cin>>n>>m;
    vector<int>a(m);
    for(int i=0;i<m;i++){
        cin>>a[i];
    }
    int steps=1;
    long long time=0;
    for(int i=0;i<m;i++){
        if(steps<=a[i]){
            time+=(a[i]-steps);
        }
        else{
            time+=(n-steps)+a[i];
        }
        steps=a[i];
    }
    cout<<time<<endl;
    return 0;
}
